{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientPairingContract",
  "description": "Formal contract for two-way QR-bridge client pairing, ephemeral session TTL, and paired device lifecycle",
  "type": "object",
  "definitions": {
    "PairingSession": {
      "type": "object",
      "description": "Ephemeral pairing session generated by console remote dialog",
      "properties": {
        "session_token": {
          "type": "string",
          "pattern": "^pair_sess_[a-zA-Z0-9_-]+$",
          "description": "Cryptographically random ephemeral session token"
        },
        "expires_in": {
          "type": "integer",
          "default": 300,
          "description": "Validity window in seconds"
        }
      },
      "required": [
        "session_token",
        "expires_in"
      ]
    },
    "AuthorizeDeviceRequest": {
      "type": "object",
      "description": "Mobile phone pairing authorization submission scanning TV QR code",
      "properties": {
        "session_token": {
          "type": "string",
          "description": "Active ephemeral session token from console"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable unique client display identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable display name (e.g. Sanctuary Main TV)"
        },
        "platform": {
          "type": "string",
          "enum": [
            "android-tv",
            "roku",
            "other"
          ],
          "description": "Target client operating platform"
        }
      },
      "required": [
        "session_token",
        "device_id",
        "name",
        "platform"
      ]
    },
    "AuthorizeDeviceResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "device_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "pattern": "^dev_tok_[a-zA-Z0-9_-]+$"
        }
      },
      "required": [
        "success",
        "device_id",
        "name",
        "token"
      ]
    },
    "PairingStatusResponse": {
      "type": "object",
      "properties": {
        "paired": {
          "type": "boolean"
        },
        "device_id": {
          "type": "string"
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paired",
        "device_id"
      ]
    },
    "PairedDevice": {
      "type": "object",
      "description": "Persistent record of an authorized client display",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "paired_at": {
          "type": "integer",
          "description": "Epoch millisecond or second timestamp when device was paired"
        },
        "last_seen": {
          "type": "integer",
          "description": "Epoch timestamp when device last polled or connected"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "platform",
        "paired_at",
        "last_seen",
        "token"
      ]
    }
  },
  "properties": {
    "PAIRING_SESSION_TTL_SECONDS": {
      "type": "integer",
      "default": 300,
      "description": "Maximum lifetime for console pairing QR session in seconds"
    },
    "ALLOW_UNAUTHENTICATED_WEB_OUTPUT": {
      "type": "boolean",
      "default": true,
      "description": "Guarantee that /live.html and /stage.html remain completely unauthenticated"
    }
  },
  "required": [
    "PAIRING_SESSION_TTL_SECONDS",
    "ALLOW_UNAUTHENTICATED_WEB_OUTPUT"
  ],
  "values": {
    "PAIRING_SESSION_TTL_SECONDS": 300,
    "ALLOW_UNAUTHENTICATED_WEB_OUTPUT": true
  }
}
