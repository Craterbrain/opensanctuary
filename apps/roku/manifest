# OpenSanctuary Roku Channel Manifest
title=OpenSanctuary Live TV
major_version=1
minor_version=0
build_version=1

# A single declared UI resolution lets Roku's own compositor uniformly scale the
# whole scene to whatever the connected display's real resolution is (every Roku
# output is 16:9, so this is never a letterboxing/aspect-ratio problem) — no manual
# per-resolution layout or scaling code needed.
ui_resolutions=fhd

# Icons and Splash Screens
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_screen_hd=pkg:/images/splash_hd.png
mm_icon_focus_fhd=pkg:/images/icon_fhd.png
mm_icon_focus_hd=pkg:/images/icon_hd.png

bs_const={DEBUG:false}
